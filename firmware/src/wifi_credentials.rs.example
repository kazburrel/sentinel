// Copy this file to `firmware/src/wifi_credentials.rs` (gitignored -- never
// committed) and fill in your real network's SSID and password.
//
// `wifi_test.rs` (and later, main.rs's WiFi upload code) pulls these in via
// `include!("../wifi_credentials.rs")`.

pub const WIFI_SSID: &str = "your-network-name";
pub const WIFI_PASSWORD: &str = "your-network-password";

// Local dev server (the `server` crate, running on the Mac) for the HTTP
// upload test. Update if your Mac's LAN IP changes.
pub const SERVER_IP: [u8; 4] = [192, 168, 1, 21];
pub const SERVER_PORT: u16 = 8080;

// Shared upload auth token -- must match server/src/config.rs's UPLOAD_TOKEN
// exactly. Sent as the X-Upload-Token header on every upload request.
pub const UPLOAD_TOKEN: &str = "generate-your-own-random-token-here";
